# Vaada local/development configuration.
# Copy to the repository-root .env (not backend/.env) and replace every placeholder.
# Never commit real secrets.

# --- Application ---
VAADA_ENV=development
VAADA_DEBUG=false
VAADA_LOG_LEVEL=INFO

# --- HTTP ---
VAADA_API_HOST=0.0.0.0
VAADA_API_PORT=8000
# Comma-separated browser origins allowed to call the API with credentials.
VAADA_CORS_ORIGINS=http://localhost:3000

# Cookie Secure flag. Keep false for local HTTP. Set true behind HTTPS.
VAADA_COOKIE_SECURE=false
VAADA_COOKIE_SAMESITE=lax

# --- Auth secrets (generate unique values; do not reuse these placeholders) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
VAADA_JWT_SECRET=replace-with-a-long-random-secret
VAADA_JWT_ISSUER=vaada-local
VAADA_JWT_AUDIENCE=vaada-ops-console
VAADA_ACCESS_TOKEN_MINUTES=15
VAADA_REFRESH_TOKEN_DAYS=7

# --- Database ---
# Local default matches docker-compose.yml
VAADA_DATABASE_URL=postgresql+psycopg://vaada:vaada@localhost:5432/vaada

# --- LLM (Ollama). Leave empty host to force LLM_UNAVAILABLE in that environment. ---
VAADA_LLM_BASE_URL=http://127.0.0.1:11434
VAADA_LLM_MODEL=llama3:8b
VAADA_LLM_TIMEOUT_SECONDS=30
VAADA_LLM_MAX_RETRIES=2

# --- Compliance (IST) ---
VAADA_CONTACT_WINDOW_START_HOUR=9
VAADA_CONTACT_WINDOW_END_HOUR=20
VAADA_MAX_CONTACTS_PER_7_DAYS=3

# --- Seed (local/demo only; do not use in production) ---
VAADA_SEED_ADMIN_EMAIL=operator@vaada.local
VAADA_SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password
