# Vaayda local/development configuration.
# Copy to the repository-root .env (not backend/.env) and replace every placeholder.
# Never commit real secrets.

# --- Application ---
VAAYDA_ENV=development
VAAYDA_DEBUG=false
VAAYDA_LOG_LEVEL=INFO

# --- HTTP ---
VAAYDA_API_HOST=0.0.0.0
VAAYDA_API_PORT=8000
# Comma-separated browser origins allowed to call the API with credentials.
VAAYDA_CORS_ORIGINS=http://localhost:3000

# Cookie Secure flag. Keep false for local HTTP. Set true behind HTTPS.
VAAYDA_COOKIE_SECURE=false
VAAYDA_COOKIE_SAMESITE=lax

# --- Auth secrets (generate unique values; do not reuse these placeholders) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
VAAYDA_JWT_SECRET=replace-with-a-long-random-secret
VAAYDA_JWT_ISSUER=vaayda-local
VAAYDA_JWT_AUDIENCE=vaayda-ops-console
VAAYDA_ACCESS_TOKEN_MINUTES=15
VAAYDA_REFRESH_TOKEN_DAYS=7

# --- Database ---
# Local default matches docker-compose.yml
VAAYDA_DATABASE_URL=postgresql+psycopg://vaayda:vaayda@localhost:5432/vaayda

# --- LLM (Ollama). Leave empty host to force LLM_UNAVAILABLE in that environment. ---
VAAYDA_LLM_BASE_URL=http://127.0.0.1:11434
VAAYDA_LLM_MODEL=llama3 8b
VAAYDA_LLM_TIMEOUT_SECONDS=30
VAAYDA_LLM_MAX_RETRIES=2

# --- Compliance (IST) ---
VAAYDA_CONTACT_WINDOW_START_HOUR=9
VAAYDA_CONTACT_WINDOW_END_HOUR=20
VAAYDA_MAX_CONTACTS_PER_7_DAYS=3

# --- Seed (local/demo only; do not use in production) ---
VAAYDA_SEED_ADMIN_EMAIL=operator@vaayda.local
VAAYDA_SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password
